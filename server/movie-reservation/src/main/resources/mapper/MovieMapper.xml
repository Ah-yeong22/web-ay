<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.korea.movie_reservation.mapper.MovieMapper">

    <insert id="insertMovie"
            parameterType="MovieVO"
            useGeneratedKeys="true"
            keyProperty="movieId">

        INSERT INTO movie (
            movie_title,
            movie_genre,
            running_time,
            ticket_price
        )
        VALUES (
            #{movieTitle},
            #{movieGenre},
            #{runningTime},
            #{ticketPrice}
        )

    </insert>

    <select id="findMovieById"
            parameterType="Integer"
            resultType="MovieVO">

        SELECT
            movie_id,
            movie_title,
            movie_genre,
            running_time,
            ticket_price,
            release_date
        FROM movie
        WHERE movie_id = #{movieId}

    </select>

</mapper>