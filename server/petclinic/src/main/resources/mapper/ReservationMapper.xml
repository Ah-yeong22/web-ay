<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.korea.petclinic.dao.ReservationDAO">

    <resultMap id="reservationMap"
               type="com.korea.petclinic.vo.ReservationVO">

        <id property="id" column="id"/>

        <result property="petName" column="pet_name"/>
        <result property="ownerName" column="owner_name"/>
        <result property="animalType" column="animal_type"/>
        <result property="doctorName" column="doctor_name"/>
        <result property="reservationDate" column="reservation_date"/>
        <result property="status" column="status"/>
        <result property="price" column="price"/>

    </resultMap>

    <select id="findAll" resultMap="reservationMap">
        SELECT *
        FROM reservation
    </select>

	<select id="findById"
			parameterType="java.lang.Long">
			resultMap="reservationMap">
		select *
		from reservation
		where id = #{id}
	</select>
	
	<insert id="insert"
			parameterType="com.korea.petclinic.vo.ReservationVO"
			useGeneratedKeys="true"
			keyProperty="id">
			
			INSERT INTO reservation(
				pet_naem,
				owner_name,
				animal_type,
				doctor_name,
				reservation_date,
				status,
				price
			)
			VALUES (
				#{petName},
	            #{ownerName},
	            #{animalType},
	            #{doctorName},
	            #{reservationDate},
	            #{status},
	            #{price}
			)
	</insert>
	
	<update id="update"
			parameterType="com.korea.petclinic.vo.ReservationVO">
			
			UPDATE reservation
			SET
				pet_name = #{petName},
	            owner_name = #{ownerName},
	            animal_type = #{animalType},
	            doctor_name = #{doctorName},
	            reservation_date = #{reservationDate},
	            status = #{status},
	            price = #{price}
	        WHERE id = #{id}
		
	</update>
	
	<delete id="delete"
			parameterType="java.lang.Long">
		
		DELETE FRom reservation
		WHERE id = #{id}	
		</delete>
		
		 <select id="searchDetail" resultMap="reservationMap">
        SELECT *
        FROM reservation

        <where>
            <choose>
                <when test="searchType == 'pet'">
                    pet_name LIKE CONCAT('%', #{keyword}, '%')
                </when>

                <when test="searchType == 'owner'">
                    owner_name LIKE CONCAT('%', #{keyword}, '%')
                </when>

                <when test="searchType == 'doctor'">
                    doctor_name LIKE CONCAT('%', #{keyword}, '%')
                </when>

                <otherwise>
                    1 = 0
                </otherwise>
            </choose>
        </where>
    </select>

    <!-- 문제 9: 진료비 정렬 -->
    <select id="sortByPrice" resultMap="reservationMap">
        SELECT *
        FROM reservation

        <choose>
            <when test="sort == 'desc'">
                ORDER BY price DESC
            </when>

            <otherwise>
                ORDER BY price ASC
            </otherwise>
        </choose>
    </select>

    <!-- 문제 10: 상태별 예약 수 -->
    <select id="countByStatus"
            resultType="com.korea.petclinic.vo.ReservationStatusCountVO">

        SELECT
            status,
            COUNT(*) AS count
        FROM reservation
        GROUP BY status
        ORDER BY status
    </select>
</mapper>